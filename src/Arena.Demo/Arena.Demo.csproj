<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RunWorkingDirectory>$(MSBuildThisFileDirectory)../..</RunWorkingDirectory>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Arena.Engine/Arena.Engine.csproj" />
    <ProjectReference Include="../Arena.Game.HideAndSeek/Arena.Game.HideAndSeek.csproj" />
    <ProjectReference Include="../Arena.Protocol/Arena.Protocol.csproj" />
    <ProjectReference Include="../Arena.Rendering/Arena.Rendering.csproj" />
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Stride.AssetCompiler" IncludeAssets="build;buildTransitive" />
  </ItemGroup>
  <!-- The asset compiler scans this Web assembly and needs its ASP.NET Core shared framework. -->
  <Target Name="ConfigureStrideCompilerRuntime" BeforeTargets="_StridePrepareAssetCompiler">
    <PropertyGroup>
      <StrideAssetCompilerHost>dotnet exec --runtimeconfig &quot;$(TargetDir)$(AssemblyName).runtimeconfig.json&quot;</StrideAssetCompilerHost>
    </PropertyGroup>
  </Target>
</Project>
